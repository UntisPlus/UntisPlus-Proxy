# Copy to .env and edit. This file is the single place a deployment is
# configured; compose reads it and passes the values through as UNTIS_* env vars.
#
# .env is gitignored. Do not put real secrets here.
#
# Two values have no default and are required: UNTIS_SCHOOL and, for the
# prebuilt-image compose file, UNTIS_IMAGE_REPO. Guessing either one would start
# a proxy pointed at the wrong school, or pull an image from an account that is
# not yours. Everything else has a default.

# Which release to run. Bump this and `docker compose pull && up -d`. The tag is
# appended to UNTIS_IMAGE_REPO, so this value decides both what is pulled and
# what /status reports — they cannot drift apart.
UNTIS_VERSION=latest

# Registry repository to pull, WITHOUT a tag, e.g. <your-namespace>/untisplus-proxy.
# Required by compose.nas.yaml. Unused by compose.yaml, which builds locally.
UNTIS_IMAGE_REPO=your-namespace/untisplus-proxy

# Host port to publish the proxy on.
UNTIS_PORT=8509

# REQUIRED. The school whose data this proxy serves. This is the school login
# name from WebUntis, not the display name, and not the server hostname: leave
# UNTIS_SERVER empty and the proxy resolves the server via school search.
UNTIS_SCHOOL=your-school-login-name

# dev | beta | prod
UNTIS_ENV=prod

# Change detection.
UNTIS_POLL_INTERVAL=60s

# ntfy server for push. Use your own instance if you have one; individual topics
# can override this with a per-topic baseUrl in the admin dashboard.
UNTIS_NTFY_BASE=https://ntfy.sh

# Externally reachable base URL (scheme + host), used for the click-through link
# on notifications. Set this when a tunnel or reverse proxy fronts the proxy, or
# notification links will be relative paths.
UNTIS_PUBLIC_BASE=

# Only if you use the Dockflare labels: set to true and name the host.
UNTIS_DOCKFLARE=false
UNTIS_HOSTNAME=untis-proxy.local
